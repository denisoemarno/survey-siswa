PORT=3000
NODE_ENV=development

# PostgreSQL (lihat docker-compose.yml di root repo untuk kredensial default)
DATABASE_URL=postgres://survey_user:survey_pass@localhost:5432/survey_siswa

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Seed admin pertama (lihat src/seeds/001_admin_user.js)
