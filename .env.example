# Dipakai oleh docker-compose.yml untuk konfigurasi seluruh stack.
# Salin ke .env dan sesuaikan (jangan commit .env asli).

POSTGRES_USER=survey_user
POSTGRES_PASSWORD=survey_pass
POSTGRES_DB=survey_siswa

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Bootstrap admin pertama (lihat api/src/seeds/001_admin_user.js)
ADMIN_EMAIL=admin@survey-siswa.test
ADMIN_PASSWORD=admin12345

# Base URL API yang di-bundle ke frontend saat build (relatif, diproksi nginx -> service api)
VITE_API_URL=/api
